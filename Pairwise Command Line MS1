"""
Pairwise Comparison General Outline
=====================================================

Compares an MZmine feature list across two conditions defined in a
metadata CSV, applies data-quality filters using your blanks and QCs,
and exports the top N most variable, statistically robust features
between the two groups.

WHAT THIS SCRIPT DOES
----------------------
1. Loads your MZmine feature list and metadata CSV.
2. Identifies condition-A samples, condition-B samples, QC samples,
   and TWO separate blank types: a solvent/MeOH blank (used for
   background-contamination filtering) and an ISTD blank (used to
   flag features that are likely your own spiked internal standards,
   not biology). These are handled separately because they answer
   different questions -- see the note above BLANK CONFIG below.
3. Fuzzy-matches metadata filenames to feature-table intensity columns
   (MZmine appends suffixes like " Peak area" to filenames).
4. Applies quality filters, in order, before any statistics:
     a. Solvent blank filtering -> drops features not clearly above
        solvent/instrument background
     b. QC RSD filtering         -> drops features not reproducible
        in pooled QCs
     c. Detection frequency      -> drops features mostly "not detected"
   Filtering on QC/blank data first (independent of the group
   comparison itself) and THEN testing is the statistically correct
   order -- it reduces the multiple-testing burden without biasing
   the result.
5. Flags (does not auto-remove) features that look like they might be
   internal-standard signal rather than biology, based on the ISTD
   blank.
6. On the surviving features: log2 transforms, computes group means,
   log2 fold change, Welch's t-test p-value, and Benjamini-Hochberg
   FDR-corrected q-value.
7. Ranks by a combined "volcano-style" score (|log2FC| x -log10(p))
   and exports the top N to a CSV, including all QC/blank/detection/
   ISTD/FDR metrics so you can see exactly why each feature made the cut.

BEFORE YOU RUN IT
------------------
Edit the CONFIG block below -- especially:
  - FEATURE_LIST_PATH / METADATA_PATH
  - METADATA_FILENAME_COL / METADATA_CONDITION_COL
  - CONDITION_A / CONDITION_B (must match your metadata values EXACTLY)
  - SOLVENT_BLANK_KEYWORDS / ISTD_BLANK_KEYWORDS / QC_KEYWORDS if your
    labels don't contain "meoh"/"solvent", "istd", or "qc"/"pool"

Requires: pandas, numpy, scipy
    pip install pandas numpy scipy
"""

import re
import numpy as np
import pandas as pd
from scipy import stats

# ============================================================
# CONFIGURATION -- edit these to match your files
# ============================================================

FEATURE_LIST_PATH = "Vc_comparative_metabolomics-1_neg_export_full_feature_table.csv"   # MZmine exported feature list (csv)
METADATA_PATH = "metadata_pairwise_comparison_LB_vs_Gluc.csv"           # your metadata csv

METADATA_FILENAME_COL = "filename"       # column in metadata.csv with sample/file names
METADATA_CONDITION_COL = "condition"     # column in metadata.csv with condition labels

CONDITION_A = "LB_Rugose"
CONDITION_B = "M9+Gluc_Rugose"

# --- Blank / QC auto-detection (case-insensitive substring match against
#     your condition column). Adjust these if your labels differ. ---
SOLVENT_BLANK_KEYWORDS = ["meoh", "solvent"]  # e.g. "MeOH_Blank" -> used for background filtering
ISTD_BLANK_KEYWORDS = ["istd"]                # e.g. "ISTD_Blank" -> used only to flag likely ISTD peaks
QC_KEYWORDS = ["qc", "pool"]

# If a sample's condition contains "blank" but matches NEITHER list above
# (e.g. you only have one generic "Blank" type), it's treated as a solvent
# blank by default so the background filter still works.
TREAT_UNLABELED_BLANK_AS_SOLVENT = True
GENERIC_BLANK_KEYWORD = "blank"

TOP_N = 50

# How to rank "most variable between the two conditions":
#   "combined"    -> |log2 fold change| x -log10(p-value)  [default, recommended]
#   "fold_change" -> rank purely by |log2 fold change|
#   "ttest"       -> rank purely by p-value (most significant first)
RANKING_METHOD = "combined"

OUTPUT_PATH = f"top_{TOP_N}_variable_features_{CONDITION_A}_vs_{CONDITION_B}.csv"

# --- Quality filter thresholds ---
BLANK_FOLD_THRESHOLD = 5      # sample signal must be >= 5x mean solvent-blank signal
QC_RSD_THRESHOLD = 30         # max allowed %RSD across pooled QC injections
MIN_DETECTION_FRACTION = 0.75 # feature must be detected (>0) in >= 75% of
                               # replicates in AT LEAST ONE of condition A/B
FDR_ALPHA = 0.05              # q-value cutoff reported/flagged (not a hard filter)

# ISTD-blank flagging (informational -- does NOT drop features by default,
# since falsely dropping real biology is riskier than leaving a flag column
# for you to review/cross-check against your known ISTD list)
ISTD_FLAG_RATIO = 3           # flag a feature if group signal < 3x its ISTD-blank signal
EXCLUDE_ISTD_FLAGGED_FEATURES = False  # set True to hard-drop flagged features instead

LOG_TRANSFORM = True   # log2-transform peak areas before stats (standard practice)
PSEUDOCOUNT = 1         # added before log transform to avoid log(0)

# ============================================================


def match_feature_columns(feature_df, sample_filenames):
    """
    MZmine feature tables typically append suffixes to the raw filename
    (e.g. 'sample1.mzML Peak area'). This matches each metadata filename
    to the best corresponding column in the feature list.
    """
    matched = {}
    unmatched = []
    feature_cols = feature_df.columns.tolist()

    for fname in sample_filenames:
        base = re.sub(r"\.(mzml|mzxml|raw|d)$", "", str(fname), flags=re.I).strip()
        candidates = [c for c in feature_cols if base.lower() in c.lower()]
        if candidates:
            area_cols = [c for c in candidates if "area" in c.lower()]
            matched[fname] = area_cols[0] if area_cols else candidates[0]
        else:
            unmatched.append(fname)

    return matched, unmatched


def fdr_bh(pvals):
    """Benjamini-Hochberg FDR correction. Returns q-values, same order as input."""
    pvals = np.asarray(pvals, dtype=float)
    n = len(pvals)
    order = np.argsort(pvals)
    ranked = pvals[order]
    q = ranked * n / np.arange(1, n + 1)
    q = np.minimum.accumulate(q[::-1])[::-1]  # enforce monotonicity
    q = np.clip(q, 0, 1)
    qvals = np.empty(n)
    qvals[order] = q
    return qvals


def main():
    feat = pd.read_csv(FEATURE_LIST_PATH)
    meta = pd.read_csv(METADATA_PATH)
    meta.columns = [c.strip() for c in meta.columns]

    for col in (METADATA_FILENAME_COL, METADATA_CONDITION_COL):
        if col not in meta.columns:
            raise ValueError(
                f"Column '{col}' not found in metadata. "
                f"Available columns: {list(meta.columns)}"
            )

    print(f"Unique values found in '{METADATA_CONDITION_COL}': {meta[METADATA_CONDITION_COL].unique().tolist()}")

    # --- Drop exact duplicate metadata rows (same filename + condition listed twice) ---
    n_meta_before = len(meta)
    meta = meta.drop_duplicates(subset=[METADATA_FILENAME_COL, METADATA_CONDITION_COL]).reset_index(drop=True)
    if len(meta) < n_meta_before:
        print(f"Dropped {n_meta_before - len(meta)} exact duplicate metadata row(s).")

    # --- Warn (and resolve) if the SAME filename appears under different conditions ---
    dup_filenames = meta[METADATA_FILENAME_COL][meta[METADATA_FILENAME_COL].duplicated()].unique().tolist()
    if dup_filenames:
        print(f"WARNING: {len(dup_filenames)} filename(s) appear under more than one condition in metadata "
              f"-- keeping only the first occurrence of each: {dup_filenames}")
        meta = meta.drop_duplicates(subset=[METADATA_FILENAME_COL], keep="first").reset_index(drop=True)

    cond_lower = meta[METADATA_CONDITION_COL].astype(str).str.lower()

    raw_istd = cond_lower.apply(lambda x: any(k in x for k in ISTD_BLANK_KEYWORDS))
    raw_solvent = cond_lower.apply(lambda x: any(k in x for k in SOLVENT_BLANK_KEYWORDS))
    raw_generic_blank = cond_lower.str.contains(GENERIC_BLANK_KEYWORD)
    raw_qc = cond_lower.apply(lambda x: any(k in x for k in QC_KEYWORDS))

    # --- Make categories mutually exclusive with a fixed priority, and warn on any overlap ---
    # Priority: ISTD blank > solvent blank > QC > generic blank fallback
    is_istd_blank = raw_istd
    is_solvent_blank = raw_solvent & ~is_istd_blank
    is_qc = raw_qc & ~is_istd_blank & ~is_solvent_blank
    is_generic_blank = raw_generic_blank & ~is_istd_blank & ~is_solvent_blank & ~is_qc
    if TREAT_UNLABELED_BLANK_AS_SOLVENT:
        is_solvent_blank = is_solvent_blank | is_generic_blank

    overlap_mask = (raw_istd.astype(int) + raw_solvent.astype(int) + raw_qc.astype(int)) > 1
    if overlap_mask.any():
        overlap_names = meta.loc[overlap_mask, METADATA_FILENAME_COL].tolist()
        print(f"WARNING: {len(overlap_names)} sample(s) matched more than one keyword category "
              f"(e.g. condition text contains both 'qc' and 'meoh') -- resolved using priority "
              f"ISTD > solvent blank > QC: {overlap_names}")

    solvent_blank_filenames = meta.loc[is_solvent_blank, METADATA_FILENAME_COL].tolist()
    istd_blank_filenames = meta.loc[is_istd_blank, METADATA_FILENAME_COL].tolist()
    qc_filenames = meta.loc[is_qc, METADATA_FILENAME_COL].tolist()
    a_filenames = meta.loc[meta[METADATA_CONDITION_COL] == CONDITION_A, METADATA_FILENAME_COL].tolist()
    b_filenames = meta.loc[meta[METADATA_CONDITION_COL] == CONDITION_B, METADATA_FILENAME_COL].tolist()

    print(f"Detected: {len(a_filenames)} {CONDITION_A} samples, {len(b_filenames)} {CONDITION_B} samples, "
          f"{len(solvent_blank_filenames)} solvent blank(s), {len(istd_blank_filenames)} ISTD blank(s), "
          f"{len(qc_filenames)} QC(s)")

    if len(a_filenames) < 2 or len(b_filenames) < 2:
        raise ValueError(
            f"Need at least 2 replicates per condition. Found {len(a_filenames)} for {CONDITION_A} "
            f"and {len(b_filenames)} for {CONDITION_B}. Check that CONDITION_A/CONDITION_B exactly "
            f"match the values in your '{METADATA_CONDITION_COL}' column."
        )

    # --- Match ALL relevant filenames to feature-table columns ---
    all_filenames = a_filenames + b_filenames + solvent_blank_filenames + istd_blank_filenames + qc_filenames
    matched, unmatched = match_feature_columns(feat, all_filenames)
    if unmatched:
        print(f"WARNING: {len(unmatched)} sample(s) had no matching column in the feature list:")
        for u in unmatched:
            print(f"   - {u}")

    group_a_cols = [matched[f] for f in a_filenames if f in matched]
    group_b_cols = [matched[f] for f in b_filenames if f in matched]
    solvent_blank_cols = [matched[f] for f in solvent_blank_filenames if f in matched]
    istd_blank_cols = [matched[f] for f in istd_blank_filenames if f in matched]
    qc_cols = [matched[f] for f in qc_filenames if f in matched]

    if len(group_a_cols) < 2 or len(group_b_cols) < 2:
        raise ValueError("Fewer than 2 matched replicates per condition after column matching -- check your feature list column names.")

    # --- Identify ID columns (row ID / m/z / RT) ---
    intensity_cols = group_a_cols + group_b_cols + solvent_blank_cols + istd_blank_cols + qc_cols

    # Safety net: if any feature-table column got pulled into more than one sample
    # group (e.g. two metadata filenames both fuzzy-matched to the same column),
    # fail here with a clear message instead of a cryptic pandas error later.
    dup_cols = [c for c in set(intensity_cols) if intensity_cols.count(c) > 1]
    if dup_cols:
        raise ValueError(
            "The same feature-table column got assigned to more than one sample group: "
            f"{dup_cols}. This usually means two metadata filenames fuzzy-matched to the same "
            "feature-list column, or one sample's condition label matched more than one keyword "
            "category. Check your metadata for duplicate/ambiguous filenames or condition labels "
            "containing overlapping keywords (e.g. both 'qc' and 'meoh')."
        )

    id_cols = [c for c in feat.columns if c not in intensity_cols]
    keep_id_cols = [c for c in id_cols if re.search(r"row (id|m/z|retention time)", c, re.I)]
    if not keep_id_cols:
        keep_id_cols = id_cols[:3]  # fallback if MZmine naming differs

    data = feat[keep_id_cols + intensity_cols].copy()
    data[intensity_cols] = data[intensity_cols].fillna(0)

    raw_a = data[group_a_cols].to_numpy(dtype=float)
    raw_b = data[group_b_cols].to_numpy(dtype=float)
    group_max_mean = np.maximum(raw_a.mean(axis=1), raw_b.mean(axis=1))

    n_features_start = len(data)
    keep_mask = np.ones(n_features_start, dtype=bool)

    # ============================================================
    # FILTER 1: Solvent blank filtering (background contamination)
    # ============================================================
    if solvent_blank_cols:
        raw_solvent_blank = data[solvent_blank_cols].to_numpy(dtype=float)
        solvent_blank_mean = raw_solvent_blank.mean(axis=1)
        blank_pass = group_max_mean >= BLANK_FOLD_THRESHOLD * (solvent_blank_mean + 1)
        data["solvent_blank_mean"] = solvent_blank_mean
        data["passes_blank_filter"] = blank_pass
        keep_mask &= blank_pass
        print(f"Solvent blank filter: {blank_pass.sum()}/{n_features_start} features pass "
              f"(>= {BLANK_FOLD_THRESHOLD}x mean solvent-blank signal)")
    else:
        print("No solvent/MeOH blank detected -- skipping background filter. "
              "(Check SOLVENT_BLANK_KEYWORDS.)")
        data["passes_blank_filter"] = True

    # ============================================================
    # ISTD blank flagging (informational, not a hard filter by default)
    # ============================================================
    if istd_blank_cols:
        raw_istd_blank = data[istd_blank_cols].to_numpy(dtype=float)
        istd_blank_mean = raw_istd_blank.mean(axis=1)
        with np.errstate(divide="ignore", invalid="ignore"):
            ratio_to_istd = np.where(istd_blank_mean > 0, group_max_mean / istd_blank_mean, np.inf)
        istd_flag = ratio_to_istd < ISTD_FLAG_RATIO
        data["ISTD_blank_mean"] = istd_blank_mean
        data["ratio_to_ISTD_blank"] = ratio_to_istd
        data["possible_ISTD_signal"] = istd_flag
        print(f"ISTD blank check: {istd_flag.sum()}/{n_features_start} feature(s) flagged as possibly "
              f"reflecting internal-standard signal rather than biology (sample intensity < {ISTD_FLAG_RATIO}x "
              f"its ISTD-blank intensity). Review these against your known ISTD list.")
        if EXCLUDE_ISTD_FLAGGED_FEATURES:
            keep_mask &= ~istd_flag
            print("EXCLUDE_ISTD_FLAGGED_FEATURES=True -> these were removed from consideration.")
    else:
        print("No ISTD blank detected -- skipping ISTD flagging. (Check ISTD_BLANK_KEYWORDS.)")
        data["possible_ISTD_signal"] = False

    # ============================================================
    # FILTER 2: QC RSD filtering (reproducibility)
    # ============================================================
    if len(qc_cols) >= 2:
        raw_qc = data[qc_cols].to_numpy(dtype=float)
        qc_mean = raw_qc.mean(axis=1)
        qc_std = raw_qc.std(axis=1, ddof=1)
        with np.errstate(divide="ignore", invalid="ignore"):
            qc_rsd = np.where(qc_mean > 0, (qc_std / qc_mean) * 100, np.inf)
        rsd_pass = qc_rsd <= QC_RSD_THRESHOLD
        data["QC_RSD_percent"] = qc_rsd
        data["passes_QC_RSD_filter"] = rsd_pass
        keep_mask &= rsd_pass
        print(f"QC RSD filter: {rsd_pass.sum()}/{n_features_start} features pass (RSD <= {QC_RSD_THRESHOLD}%)")
    else:
        print("Fewer than 2 QC samples detected -- skipping QC RSD filter. (Check QC_KEYWORDS.)")
        data["passes_QC_RSD_filter"] = True

    # ============================================================
    # FILTER 3: Detection frequency
    # ============================================================
    detect_frac_a = (raw_a > 0).mean(axis=1)
    detect_frac_b = (raw_b > 0).mean(axis=1)
    detect_pass = (detect_frac_a >= MIN_DETECTION_FRACTION) | (detect_frac_b >= MIN_DETECTION_FRACTION)
    data["detection_fraction_A"] = detect_frac_a
    data["detection_fraction_B"] = detect_frac_b
    data["passes_detection_filter"] = detect_pass
    keep_mask &= detect_pass
    print(f"Detection filter: {detect_pass.sum()}/{n_features_start} features pass "
          f"(detected in >= {int(MIN_DETECTION_FRACTION*100)}% of replicates in at least one group)")

    print(f"\nFeatures passing all active quality filters: {keep_mask.sum()}/{n_features_start}")

    filtered = data[keep_mask].copy()
    if len(filtered) == 0:
        raise ValueError("No features survived quality filtering -- thresholds may be too strict for your data. "
                          "Consider relaxing BLANK_FOLD_THRESHOLD, QC_RSD_THRESHOLD, or MIN_DETECTION_FRACTION.")

    # ============================================================
    # Statistics on filtered features only
    # ============================================================
    vals_a = filtered[group_a_cols].to_numpy(dtype=float)
    vals_b = filtered[group_b_cols].to_numpy(dtype=float)

    if LOG_TRANSFORM:
        vals_a = np.log2(vals_a + PSEUDOCOUNT)
        vals_b = np.log2(vals_b + PSEUDOCOUNT)

    mean_a = vals_a.mean(axis=1)
    mean_b = vals_b.mean(axis=1)
    log2fc = mean_b - mean_a  # positive = higher in condition B

    tstat, pval = stats.ttest_ind(vals_b, vals_a, axis=1, equal_var=False, nan_policy="omit")
    qval = fdr_bh(pval)

    filtered[f"mean_{CONDITION_A}"] = mean_a
    filtered[f"mean_{CONDITION_B}"] = mean_b
    filtered["log2FC_B_over_A"] = log2fc
    filtered["t_statistic"] = tstat
    filtered["p_value"] = pval
    filtered["q_value_FDR"] = qval
    filtered["significant_FDR_0.05"] = qval <= FDR_ALPHA

    n_sig = (qval <= FDR_ALPHA).sum()
    print(f"Of these, {n_sig}/{len(filtered)} are significant at FDR <= {FDR_ALPHA}")

    p_safe = np.clip(pval, 1e-300, 1)
    if RANKING_METHOD == "fold_change":
        filtered["rank_score"] = filtered["log2FC_B_over_A"].abs()
    elif RANKING_METHOD == "ttest":
        filtered["rank_score"] = -np.log10(p_safe)
    else:  # combined (default)
        filtered["rank_score"] = filtered["log2FC_B_over_A"].abs() * -np.log10(p_safe)

    top_features = filtered.sort_values("rank_score", ascending=False).head(TOP_N)
    top_features.to_csv(OUTPUT_PATH, index=False)

    print(f"\nSaved top {min(TOP_N, len(filtered))} features to: {OUTPUT_PATH}")


if __name__ == "__main__":
    main()
