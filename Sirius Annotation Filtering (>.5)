"""
GENERATED BY CLAUDE AI

Filter a SIRIUS structure prediction table down to rows with a confidence
score above a threshold, handling Excel-corrupted score cells (#NAME?, #N/A,
#VALUE!, #REF!) that show up when a file has been opened/saved in Excel.

Usage:
    python filter_sirius_confidence.py input.csv output.csv
    python filter_sirius_confidence.py input.tsv output.csv --sep "\t" --threshold 0.5
"""

import argparse
import sys
import pandas as pd

# Excel error strings that can end up literally saved into a CSV/TSV cell.
# Anything in this set gets treated as missing, not as a real value.
EXCEL_ERROR_STRINGS = ["#NAME?", "#NAME!", "#N/A", "#VALUE!", "#REF!", "#NULL!", "#DIV/0!"]

# Column names SIRIUS/CSI:FingerID commonly use for the structure confidence
# score, in rough order of how likely you are to see them. Adjust/add to this
# if your export uses a different header.
CANDIDATE_COLUMN_NAMES = [
    "ConfidenceScore",
    "ConfidenceScoreExact",
    "ConfidenceScoreApproximate",
    "confidenceScore",
    "CSI:FingerIDScore",
    "csiFingerIdScore",
]


def find_confidence_column(df, user_specified=None):
    """Pick the confidence score column, either the one the user named or
    the first match from CANDIDATE_COLUMN_NAMES. Fails loudly rather than
    guessing wrong, since silently picking the wrong column is worse than
    stopping."""
    if user_specified:
        if user_specified not in df.columns:
            sys.exit(
                f"Column '{user_specified}' not found. Available columns:\n"
                + "\n".join(df.columns)
            )
        return user_specified

    for name in CANDIDATE_COLUMN_NAMES:
        if name in df.columns:
            return name

    sys.exit(
        "Could not auto-detect a confidence score column. "
        "Pass one explicitly with --column. Available columns:\n"
        + "\n".join(df.columns)
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input_file", help="Path to the SIRIUS structure prediction CSV/TSV")
    parser.add_argument("output_file", help="Path to write the filtered CSV")
    parser.add_argument(
        "--sep",
        default=",",
        help="Field separator of the input file (default: ','; use '\\t' for SIRIUS's native TSV export)",
    )
    parser.add_argument(
        "--column",
        default=None,
        help="Name of the confidence score column, if it's not auto-detected correctly",
    )
    parser.add_argument(
        "--threshold",
        type=float,
        default=0.5,
        help="Minimum confidence score to keep (default: 0.5)",
    )
    args = parser.parse_args()

    # Read everything as-is first (no na_values yet) so we can report exactly
    # what garbage was in the raw file before we start cleaning it.
    df = pd.read_csv(args.input_file, sep=args.sep, dtype=str)

    col = find_confidence_column(df, args.column)
    total_rows = len(df)

    # How many rows currently hold one of the known Excel error strings,
    # before we touch anything -- this is the number you actually care about
    # diagnostically (data lost to corruption, not to a genuinely low score).
    is_excel_error = df[col].isin(EXCEL_ERROR_STRINGS)
    n_excel_errors = int(is_excel_error.sum())

    # Coerce to numeric. Excel error strings AND any other non-numeric junk
    # become NaN here (errors="coerce"), rather than throwing.
    df[col] = pd.to_numeric(df[col], errors="coerce")

    n_other_unparseable = int(df[col].isna().sum()) - n_excel_errors
    n_missing_total = int(df[col].isna().sum())

    # Rows that are missing (corrupted or blank) are excluded from the
    # numeric comparison automatically, since NaN > threshold is False.
    # We keep them out of the output rather than silently including them.
    filtered = df[df[col] > args.threshold].copy()

    filtered.to_csv(args.output_file, index=False)

    print(f"Column used: '{col}'")
    print(f"Total rows in input: {total_rows}")
    print(f"Rows with Excel error strings (e.g. #NAME?) in this column: {n_excel_errors}")
    if n_other_unparseable > 0:
        print(f"Rows with other unparseable (non-numeric) values: {n_other_unparseable}")
    print(f"Total rows excluded as missing/unparseable: {n_missing_total}")
    print(f"Rows with a valid numeric score <= {args.threshold}: "
          f"{total_rows - n_missing_total - len(filtered)}")
    print(f"Rows kept (score > {args.threshold}): {len(filtered)}")
    print(f"Written to: {args.output_file}")


if __name__ == "__main__":
    main()
